{
  "name": "nha-trang-bike-sharing",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @bike-sharing/web --filter @bike-sharing/api dev",
    "dev:web": "pnpm --filter @bike-sharing/web dev",
    "dev:api": "pnpm --filter @bike-sharing/api dev",
    "build": "pnpm --filter @bike-sharing/web build && pnpm --filter @bike-sharing/api build",
    "typecheck": "pnpm --recursive --if-present typecheck"
  }
}
