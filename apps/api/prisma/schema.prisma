generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ScooterStatus {
  AVAILABLE
  IN_RIDE
  PARKED
  MAINTENANCE
  OFFLINE
}

enum RideStatus {
  ACTIVE
  COMPLETED
  REJECTED
  CANCELLED
}

enum ListingCategory {
  BIKE_SALE
  BIKE_RENTAL
  HOUSING_RENTAL
}

enum SubscriptionType {
  HOUSING_TOP
  BIKE_SALE_FEED
}

enum StoryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LocationSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Scooter {
  id               String        @id @default(cuid())
  code             String        @unique
  model            String        @default("Honda Lead 125")
  year             Int
  plate            String?       @unique
  status           ScooterStatus @default(AVAILABLE)
  batteryPercent   Int?
  fuelPercent      Int?
  helmetCount      Int           @default(1)
  hasRainwear      Boolean       @default(false)
  hasRemoteAccess  Boolean       @default(false)
  latitude         Float?
  longitude        Float?
  locationUpdatedAt DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  rides            Ride[]

  @@index([status])
}

model Ride {
  id              String     @id @default(cuid())
  scooterId       String
  scooter         Scooter    @relation(fields: [scooterId], references: [id])
  userId          String?
  user            AppUser?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  status          RideStatus @default(ACTIVE)
  startedAt       DateTime   @default(now())
  endedAt         DateTime?
  startLatitude   Float?
  startLongitude  Float?
  endLatitude     Float?
  endLongitude    Float?
  distanceKm      Float?
  endRejected     Boolean    @default(false)
  rejectionReason String?
  createdAt       DateTime   @default(now())

  @@index([status, startedAt])
  @@index([scooterId, startedAt])
}

model AppUser {
  id         String   @id @default(cuid())
  telegramId String?  @unique
  phone      String?
  trips      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  rides      Ride[]

  @@index([trips])
}

model ParkingZone {
  id          String   @id @default(cuid())
  name        String
  // GeoJSON Polygon coordinates: [longitude, latitude] pairs.
  polygon     Json
  isNoParking Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, isNoParking])
}

model ContentPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  html      String   @db.Text
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Story {
  id          String      @id @default(cuid())
  title       String
  posterUrl   String
  text        String      @db.Text
  description String?     @db.Text
  linkUrl     String?
  linkLabel   String?
  status      StoryStatus @default(DRAFT)
  sortOrder   Int         @default(0)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, publishedAt, sortOrder])
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @db.Text
  body        String   @db.Text
  coverUrl    String
  category    String   @default("guide")
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, featured, publishedAt])
}

model HomePageSettings {
  id        Int      @id @default(1)
  sections  Json
  updatedAt DateTime @updatedAt
}

model Listing {
  id            String           @id @default(cuid())
  category      ListingCategory
  title         String
  description   String?          @db.Text
  price         Decimal?         @db.Decimal(12, 2)
  currency      String           @default("VND")
  address       String?
  latitude      Float?
  longitude     Float?
  areaSqm       Float?
  bedrooms      Int?
  bathrooms     Int?
  hasTv         Boolean          @default(false)
  hasFridge     Boolean          @default(false)
  hasTables     Boolean          @default(false)
  amenities     String[]         @default([])
  imageUrls     String[]         @default([])
  contact       String?
  promotedUntil DateTime?
  published     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  placements    TopPlacement[]
  subscriptions Subscription[]

  @@index([category, published, createdAt])
}

model Partner {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  websiteUrl     String?
  affiliateUrl   String?
  commissionNote String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  exchangeRates ExchangeRate[]
}

model ExchangeRate {
  id          String   @id @default(cuid())
  partnerId   String?
  partner     Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  baseCode    String
  quoteCode   String
  rate        Decimal  @db.Decimal(18, 6)
  sourceLabel String?
  checkedAt   DateTime @default(now())
  active      Boolean  @default(true)

  @@index([active, baseCode, quoteCode, checkedAt])
}

model LocationSubmission {
  id          String                   @id @default(cuid())
  telegramId  String?
  title       String
  description String                   @db.Text
  latitude    Float
  longitude   Float
  category    String                   @default("place")
  imageUrl    String?
  status      LocationSubmissionStatus @default(PENDING)
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([status, createdAt])
}

model CashbackTier {
  id                   String   @id @default(cuid())
  minimumCompletedTrips Int
  cashbackPercent      Decimal  @db.Decimal(5, 2)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([minimumCompletedTrips])
  @@index([active, minimumCompletedTrips])
}

model Subscription {
  id        String           @id @default(cuid())
  listingId String
  listing   Listing          @relation(fields: [listingId], references: [id])
  type      SubscriptionType
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())

  @@index([type, active, endsAt])
  @@index([listingId, active])
}

model TopPlacement {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  category  ListingCategory
  position  Int
  active    Boolean  @default(true)
  startsAt  DateTime @default(now())
  endsAt    DateTime?
  createdAt DateTime @default(now())

  @@unique([category, position, startsAt])
  @@index([position, active, startsAt, endsAt])
}
